{
    "spec_version": "v1.34",
    "identifier": "SCANsat-GPU",
    "name": "SCANsat (GPU Visual - RSS RAM fork)",
    "abstract": "A fork of SCANsat that composites the Visual map mode on the GPU, so it no longer keeps a large CPU-readable copy of each body's ScaledSpace textures. Under Real Solar System that copy costs hundreds of MB of RAM per body; this fork removes it.",
    "author": [ "miskoltrans", "SCANsat contributors" ],
    "license": "BSD-3-clause",
