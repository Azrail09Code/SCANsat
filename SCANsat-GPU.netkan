        "repository": "https://github.com/miskoltrans/SCANsat-GPU",
        "bugtracker": "https://github.com/miskoltrans/SCANsat-GPU/issues"
    },
    "depends": [
        { "name": "ModuleManager" }
    ],
    "recommends": [
        { "name": "Toolbar" }
    ],
    "provides":  [ "SCANsat" ],
    "conflicts": [ { "name": "SCANsat" } ],
    "tags": [ "plugin", "information", "science" ],
    "x_netkan_github": { "use_source_archive": false },
    "x_note_deps": "Mirror upstream SCANsat.netkan (KSP-CKAN/CKAN-meta) for the exact depends/recommends/suggests before submitting; SCANsat also integrates with RasterPropMonitor if present."
